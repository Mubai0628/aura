{
  "about": "L13 browser site rules. Rust (aura-browser-domain) and the browser host (electron-main/browser-host/site-rules.ts) both run these cases, so a rule means the same thing on both sides. A rule is a host name, '*.' and a host name (its subdomains, not the host itself), an IPv4 address or a bracketed IPv6 address, with an optional port; without a port it covers every port and scheme. A pasted http(s) address keeps only its host and any port written in it.",
  "parse": [
    { "input": "example.com", "rule": "example.com" },
    { "input": "  Example.COM. ", "rule": "example.com" },
    { "input": "*.example.com", "rule": "*.example.com" },
    { "input": "*.Example.com:8080", "rule": "*.example.com:8080" },
    { "input": "localhost", "rule": "localhost" },
    { "input": "localhost:5173", "rule": "localhost:5173" },
    { "input": "127.0.0.1", "rule": "127.0.0.1" },
    { "input": "127.0.0.1:8000", "rule": "127.0.0.1:8000" },
    { "input": "[::1]", "rule": "[::1]" },
    { "input": "[::1]:3000", "rule": "[::1]:3000" },
    { "input": "[0:0:0:0:0:0:0:1]", "rule": "[::1]" },
    { "input": "https://www.example.com/path?q=1", "rule": "www.example.com" },
    { "input": "http://example.com:8080/", "rule": "example.com:8080" },
    { "input": "xn--fsq.com", "rule": "xn--fsq.com" },
    { "input": "", "error": "empty" },
    { "input": "   ", "error": "empty" },
    { "input": "*", "error": "host" },
    { "input": "*.", "error": "host" },
    { "input": "a.*.com", "error": "host" },
    { "input": "*.127.0.0.1", "error": "host" },
    { "input": "exa mple.com", "error": "host" },
    { "input": "-bad.com", "error": "host" },
    { "input": "bad-.com", "error": "host" },
    { "input": "under_score.com", "error": "host" },
    { "input": "例子.com", "rule": "xn--fsqu00a.com" },
    { "input": "*.例子.com", "rule": "*.xn--fsqu00a.com" },
    { "input": "example.com:0", "error": "port" },
    { "input": "example.com:65536", "error": "port" },
    { "input": "example.com:http", "error": "port" },
    { "input": "ftp://example.com", "error": "scheme" },
    { "input": "file:///C:/x.html", "error": "scheme" },
    { "input": "user:pass@example.com", "error": "host" },
    { "input": "::1", "error": "host" }
  ],
  "match": [
    { "rule": "example.com", "url": "https://example.com/", "matches": true },
    { "rule": "example.com", "url": "http://example.com:8080/x", "matches": true },
    { "rule": "example.com", "url": "wss://example.com/socket", "matches": true },
    { "rule": "example.com", "url": "https://www.example.com/", "matches": false },
    { "rule": "example.com", "url": "https://badexample.com/", "matches": false },
    { "rule": "example.com", "url": "https://example.com.evil.net/", "matches": false },
    { "rule": "*.example.com", "url": "https://www.example.com/", "matches": true },
    { "rule": "*.example.com", "url": "http://a.b.example.com:8080/x", "matches": true },
    { "rule": "*.example.com", "url": "https://example.com/", "matches": false },
    { "rule": "*.example.com", "url": "https://notexample.com/", "matches": false },
    { "rule": "example.com:443", "url": "https://example.com/", "matches": true },
    { "rule": "example.com:443", "url": "http://example.com/", "matches": false },
    { "rule": "example.com:8080", "url": "http://example.com:8080/", "matches": true },
    { "rule": "localhost:5173", "url": "http://localhost:5173/", "matches": true },
    { "rule": "localhost:5173", "url": "http://localhost:5174/", "matches": false },
    { "rule": "localhost", "url": "http://LOCALHOST:3000/", "matches": true },
    { "rule": "127.0.0.1", "url": "http://127.0.0.1:8000/", "matches": true },
    { "rule": "127.0.0.1", "url": "http://0x7f.0.0.1/", "matches": true },
    { "rule": "127.0.0.1", "url": "http://127.0.0.2/", "matches": false },
    { "rule": "[::1]", "url": "http://[::1]:3000/", "matches": true },
    { "rule": "[::1]:3000", "url": "http://[0:0::1]:3000/", "matches": true },
    { "rule": "xn--fsq.com", "url": "https://例.com/", "matches": true },
    { "rule": "example.com", "url": "https://EXAMPLE.com./", "matches": true }
  ],
  "no_site": [
    "file:///C:/game/index.html",
    "about:blank",
    "data:text/html,hi",
    "blob:https://example.com/123",
    "javascript:alert(1)",
    "chrome://settings",
    "ftp://example.com/"
  ]
}
