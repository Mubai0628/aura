                      {
                        "type": "null"
                      }
                    ]
                  },
                  "line_ending": {
                    "$ref": "#/$defs/LineEnding"
                  },
                  "logical_hash": {
                    "$ref": "#/$defs/ContentHash",
                    "description": "Hash of the bytes this mutation wrote."
