                "type": "object"
              },
              "ContentHashAlgorithm": {
                "enum": ["blake3", "sha256"],
                "type": "string"
              },
              "DeferredMutationId": {
                "type": "string"
              },
              "ExternalGrantId": {
                "type": "string"
              },
              "FsExternalWriteTarget": {
                "additionalProperties": false,
                "description": "The authorized external file one mutation wrote.",
                "properties": {
                  "bytes_written": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "created": {
                    "description": "True when this call created the file instead of replacing one.",
                    "type": "boolean"
                  },
                  "display_path": {
                    "description": "The absolute path as the user sees it.",
