      "canonical_name": "fs.write",
      "display_name": "Write a workspace file",
      "model_description": "Write a whole UTF-8 file. expected is absent for a new file, or the logical_hash from your latest read of an existing one; if the file changed since, nothing is written, so read it again. A path outside the workspace needs an authorization the user attached to this session.",
      "model_summary": "Write a workspace file",
      "input_schema": {
        "schema_dialect": "json_schema_draft_2020_12",
        "schema_policy_version": 1,
        "document": {
          "$defs": {
            "AgentWorkspacePath": {
              "description": "A path relative to the workspace root (\".\" is the root). An absolute path inside the workspace names the same file.",
              "type": "string"
            },
            "ContentHash": {
              "additionalProperties": false,
              "properties": {
                "algorithm": {
                  "$ref": "#/$defs/ContentHashAlgorithm"
                },
                "hex": {
                  "type": "string"
                }
              },
              "required": ["algorithm", "hex"],
              "type": "object"
            },
            "ContentHashAlgorithm": {
              "enum": ["blake3", "sha256"],
              "type": "string"
            },
            "FsExpectedState": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "expected_kind": {
                      "const": "absent",
                      "type": "string"
                    }
                  },
                  "required": ["expected_kind"],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "expected_kind": {
                      "const": "file_hash",
                      "type": "string"
                    },
                    "hash": {
                      "$ref": "#/$defs/ContentHash"
                    }
                  },
                  "required": ["expected_kind", "hash"],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "expected_kind": {
                      "const": "directory",
                      "type": "string"
                    }
                  },
                  "required": ["expected_kind"],
                  "type": "object"
                }
              ]
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "expected": {
              "$ref": "#/$defs/FsExpectedState"
            },
            "path": {
              "$ref": "#/$defs/AgentWorkspacePath"
            },
            "text": {
              "type": "string"
            }
          },
          "required": ["path", "text", "expected"],
          "type": "object"
        },
        "schema_hash": {
          "algorithm": "sha256",
          "canonicalization_version": "rfc8785_jcs_v1",
          "hex": "8ecd4b4ff1e6eb2aa43eef50de7182664d385e5bfb7ad40e006f959ae8f6137c"
        }
      },
      "strict": true,
      "result_contract": {
        "type": "structured_json",
        "result_schema": {
          "schema_dialect": "json_schema_draft_2020_12",
