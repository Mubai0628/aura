root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,jsonc,js,mjs,cjs,ts,tsx,css,html,yml,yaml,toml}]
indent_style = space
indent_size = 2

[*.rs]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{ps1,psm1}]
indent_style = space
indent_size = 4
end_of_line = crlf
