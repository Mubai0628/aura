{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["DOM", "ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vite.preload.config.ts",
    "vite.acceptance.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/**/*.ts",
    "shared/**/*.ts",
    "renderer/src/aura-window.d.ts"
  ],
  "exclude": ["shared/**/*.test.ts"]
}
