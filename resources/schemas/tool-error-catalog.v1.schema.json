    "ToolErrorCatalogEntryV1": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/ErrorCategory"
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "retry_class": {
          "$ref": "#/$defs/ToolErrorRetryClassV1"
        },
        "safe_message_key": {
          "type": "string"
        },
        "suggested_not_executed_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolNotExecutedReasonV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "$ref": "#/$defs/ToolErrorVisibilityV1"
        }
      },
      "required": [
        "code",
        "category",
        "visibility",
        "retry_class",
        "safe_message_key"
      ],
      "type": "object"
    },
    "ToolErrorRetryClassV1": {
      "enum": [
        "never",
        "conditional",
        "retryable"
      ],
      "type": "string"
    },
    "ToolErrorVisibilityV1": {
      "enum": [
        "internal_only",
        "renderer_safe",
        "model_safe",
        "renderer_and_model_safe"
      ],
      "type": "string"
    },
    "ToolNotExecutedReasonV1": {
      "enum": [
        "schema_validation_failed",
        "tool_not_found",
        "version_mismatch",
        "not_loaded",
        "disabled",
        "trust_required",
        "audience_denied",
        "purpose_required",
        "permission_denied",
        "approval_denied",
        "runtime_unavailable",
        "dependency_not_executed",
        "atomic_group_not_executed",
        "lineage_reconciliation",
        "completion_review",
        "cancelled_before_dispatch",
        "batch_rejected",
        "resource_claim_resolution_failed"
      ],
      "type": "string"
    }
  },
  "$id": "https://schemas.aura.local/contracts/v1/tool-error-catalog.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalog_version": {
      "const": 1,
      "type": "integer"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/ToolErrorCatalogEntryV1"
      },
      "maxItems": 148,
      "minItems": 148,
      "type": "array"
    }
  },
  "required": [
    "catalog_version",
    "entries"
  ],
  "title": "AuraToolErrorCatalogV1",
  "type": "object"
}
